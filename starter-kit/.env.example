# Copy to .env (never commit it). Real environment variables win over this file.
ARENA_URL=https://arena.tacto.ai
# Your team's key from https://arena.tacto.ai/apply (one per team; never commit it)
ARENA_API_KEY=
# The unpacked data package (`arena data` puts it here; for the LLM agent and the MCP server)
ARENA_DATA=data/package

# LLM for the example agent - your own key. Either Anthropic ...
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
ANTHROPIC_API_KEY=
# ... or any OpenAI-compatible endpoint (OpenAI, Mistral, Groq, a local Ollama, ...)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=
# LLM_API_KEY=

# Buyer agent (arena_kit/buyer) - see ../README.md
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-6.1-sol
# LLM_EFFORT=medium
# LLM_FALLBACK_MODEL=gpt-6-luna
# DECISIONS_ENABLED=1
# DECISIONS_MODEL=gpt-6-luna
# LLM_TURN=1
# BUYER_CONCURRENT=0
# BUYER_RUNS=runs
